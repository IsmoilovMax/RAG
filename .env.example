# ---------------------------------------------------------------------------
# DocuMind configuration. Copy to `.env` (repo root or backend/) and edit.
# Every variable is optional except POSTGRES_PASSWORD for docker compose.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=DocuMind RAG
ENVIRONMENT=development          # development | production | test
LOG_LEVEL=INFO
LOG_JSON=false                   # true = structured JSON logs (recommended in production)
# Comma-separated list of allowed browser origins (only needed when the UI is
# served from a different origin than the API; not needed with docker compose).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared secret required on every non-health endpoint (X-API-Key header or
# "Authorization: Bearer"). Leave empty to disable auth for local use.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Storage ---
# DATA_DIR holds uploads, the Chroma index and (by default) the SQLite DB.
# DATA_DIR=./data
# SQLite is used when DATABASE_URL is empty. PostgreSQL example:
# DATABASE_URL=postgresql://documind:password@localhost:5432/documind
DATABASE_URL=
CHROMA_COLLECTION=documents

# --- Uploads ---
MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=20

# --- Embeddings (CPU) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
# TORCH_NUM_THREADS=4            # defaults to all cores

# --- Local LLM (Ollama, CPU) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b          # any model from `ollama list`, e.g. llama3.2:3b, phi3.5
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_THREAD=4            # CPU threads used by Ollama for generation
OLLAMA_KEEP_ALIVE=30m            # keep the model loaded between questions

# --- RAG defaults (also adjustable at runtime on the Settings page) ---
LLM_TEMPERATURE=0.1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.55        # cosine similarity; below this, chunks are discarded
RELATIVE_SCORE_CUTOFF=0.12       # drop chunks this far below the best match
MAX_CONTEXT_CHARS=6000
HISTORY_TURNS=3

# --- Background processing ---
INGESTION_WORKERS=1

# --- docker compose only ---
HTTP_PORT=8080
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-to-a-long-random-password
BACKEND_MEMORY_LIMIT=3g
